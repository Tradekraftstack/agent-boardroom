def api_key_for(provider):
    """Saved with `boardroom apikey PROVIDER`, or from $PROVIDER_API_KEY / $BOARDROOM_API_KEY."""
    try:
        saved = load_conf().get("api_keys", {}).get(provider)
    except SystemExit:
        saved = None
    return saved or os.environ.get(f"{provider.upper()}_API_KEY") or os.environ.get("BOARDROOM_API_KEY", "")


def run_api(turn, opts):
    provider = opts["adapter"]
    base, model = API_PRESETS[provider]
    base, model = (opts.get("base") or base).rstrip("/"), opts.get("model") or model
    if not base or not model:
        raise RuntimeError(f"--adapter {provider} needs --base URL and --model NAME")
    key = api_key_for(provider)
    body = {"model": model, "messages": [{"role": "user", "content": turn["prompt"]}], "max_tokens": 1200}
    headers = {"Content-Type": "application/json"}
    if key:
        headers["Authorization"] = f"Bearer {key}"
    for attempt in range(3):
        req = urllib.request.Request(base + "/chat/completions", data=json.dumps(body).encode(),
                                     method="POST", headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=opts["timeout"]) as r:
                text = json.loads(r.read())["choices"][0]["message"].get("content") or ""
            import re
            return re.sub(r"<think>.*?</think>", "", text, flags=re.S).strip()
        except urllib.error.HTTPError as e:
            detail = e.read()[:300].decode("utf-8", "replace")
            if e.code == 400 and "max_completion_tokens" in detail and "max_tokens" in body:
                body["max_completion_tokens"] = body.pop("max_tokens")
                continue
            raise RuntimeError(f"{provider} HTTP {e.code}: {detail}")
    raise RuntimeError(f"{provider} gave no answer")


ADAPTERS = {"claude": run_claude, "codex": run_codex, "cmd": run_cmd}
ADAPTERS.update({p: run_api for p in API_PRESETS})


# ---------- work jobs: room turns only talk; a WORK: line starts the real job with full tools

WORK_DIR = os.path.join(CONF_DIR, "work")
WORK_CAP = 15  # jobs per agent per day
WORK_TIMEOUT = 3600
STAGING = os.path.expanduser(os.environ.get("BOARDROOM_WORK_DIR", "~/boardroom-work"))
WORK_NOTE = """

(Note from your runner: you can't do long work inside this reply, but you CAN start it. If you were asked to
make or do something you can do yourself (a deck, PDF, doc, sheet, code, research, a fix), say what you'll make,
then end your reply with ONE line:
WORK: <the whole task in one sentence, with any file paths you know>
Your runner starts it right after this message in this same session, with your full tools, and posts the
finished files here. Don't promise work "now" without a WORK: line, and never say it's done before it is.)"""

_jobs = {"active": {}}  # (agent, channel) -> {"task", "started"}
_jobs_lock = threading.Lock()


def _work_count(agent):
    path = os.path.join(CONF_DIR, "work-count.json")
    day = time.strftime("%Y-%m-%d")
    try:
        with open(path) as f:
            c = json.load(f)
    except (FileNotFoundError, ValueError):
        c = {}
    if c.get("day") != day:
        c = {"day": day}
    return path, c


def queue_work(agent, channel, task):
    """Queue a job for this agent's runner (the runner picks it up within seconds)."""
    os.makedirs(WORK_DIR, exist_ok=True)
    job = {"agent": agent, "channel": channel, "task": task.strip()[:2000], "queued": time.time()}
    path = os.path.join(WORK_DIR, f"{int(time.time() * 1000)}-{agent}.json")
    with open(path, "w") as f:
        json.dump(job, f)
    return path


def work_prompt(agent, channel, task):
    out = os.path.join(STAGING, channel)
    return f"""[Board Room work job] In #{channel} you committed to this job:
{task}

This is your real work session now, with your full tools (files, shell, web). Do the complete job now, end to end.
Don't stop at a plan and don't ask for permission for ordinary steps.

Rules:
- Save finished work in {out}/ (create it if needed). Documents people will read go out as PDF.
- Never send emails or messages, post anything publicly, spend money, or use paid API keys.
  If the job truly needs one of those, do everything else, then say exactly what you need.
- Don't post to the room yourself; your final reply is posted for you.

When you're done, reply with a short report for the room (under 120 words): what you made, and anything
still needed. Then list each finished file on its own line exactly like this:
FILE: /absolute/path/to/file.pdf"""


def run_work_claude(agent, channel, prompt):
    sid = session_get(agent, channel)
    cwd = (claude_session_cwd(sid) if sid else None) or os.path.expanduser("~")
    cmd = [find_bin("claude"), "-p", "--output-format", "json", "--permission-mode", "acceptEdits",
           "--allowedTools", "Bash,Read,Write,Edit,MultiEdit,Glob,Grep,WebFetch,WebSearch,Skill,TodoWrite"]
    cmd += ["--resume", sid] if sid else ["--session-id", str(uuid.uuid4())]
    p = subprocess.run(cmd, input=prompt, capture_output=True, text=True, timeout=WORK_TIMEOUT, cwd=cwd)
    try:
        out = json.loads(p.stdout)
    except ValueError:
        raise RuntimeError((p.stderr or p.stdout)[-400:])
    if out.get("is_error") or (p.returncode != 0 and not out.get("result")):
        raise RuntimeError(str(out.get("result") or p.stderr)[-400:])
    if out.get("session_id"):
        session_set(agent, channel, out["session_id"])
    return out.get("result", "").strip()


def run_work_codex(agent, channel, prompt):
    sid = session_get(agent, channel)
    with tempfile.TemporaryDirectory() as td:
        last = os.path.join(td, "last.txt")
        common = ["--skip-git-repo-check", "--json", "-o", last, "-c", "sandbox_mode=\"workspace-write\"",
                  "-c", "sandbox_workspace_write.network_access=true",
                  "-c", f"sandbox_workspace_write.writable_roots=[\"{STAGING}\"]"]
        if sid:
            cwd = codex_session_cwd(sid) or os.path.expanduser("~")
            cmd = [find_bin("codex"), "exec", "resume", sid] + common + ["-"]
        else:
            cwd = os.path.expanduser("~")
            cmd = [find_bin("codex"), "exec", "-C", cwd] + common + ["-"]
        p = subprocess.run(cmd, input=prompt, capture_output=True, text=True, timeout=WORK_TIMEOUT, cwd=cwd)
        if p.returncode != 0:
            raise RuntimeError((p.stderr or p.stdout)[-400:])
        for line in p.stdout.splitlines():
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            if ev.get("type") == "thread.started" and ev.get("thread_id"):
                session_set(agent, channel, ev["thread_id"])
        with open(last) as f:
            return f.read().strip()


def run_job(room, adapter, job):
    agent, ch, task = job["agent"], job["channel"], job["task"]
    os.makedirs(os.path.join(STAGING, ch), exist_ok=True)
    fn = {"claude": run_work_claude, "codex": run_work_codex}.get(adapter)
    t0 = time.time()
    print(f"work job for {agent} in #{ch}: {task[:120]}", flush=True)
    try:
        if not fn:
            raise RuntimeError(f"the {adapter} adapter can't run work jobs")
        report, kind = fn(agent, ch, work_prompt(agent, ch, task)) or "(finished, no report)", "present"
    except Exception as e:
        report, kind = f"Work job failed: {task[:200]}\n({str(e)[:300]})", "error"
    files, lines = [], []
    for line in report.splitlines():
        if line.strip().upper().startswith("FILE:"):
            path = os.path.expanduser(line.split(":", 1)[1].strip().strip("`"))
            if os.path.isfile(path) and os.path.getsize(path) < 25 * 1024 * 1024:
                try:
                    files.append(upload(room, path))
                    continue
                except (urllib.error.URLError, OSError):
                    pass
            lines.append(f"{line} (couldn't attach)")
        else:
            lines.append(line)
    text = "\n".join(lines).strip() + f"\n\n(work job, {int(time.time() - t0) // 60} min)"
    for attempt in range(3):
        try:
            room.call("/api/say", {"text": text, "channel": ch, "kind": kind, "files": files})
            break
        except (urllib.error.URLError, OSError) as e:
            print(f"post failed: {e}", flush=True)
            time.sleep(5)
    print(f"work job done for {agent} in #{ch} ({len(files)} files, {time.time() - t0:.0f}s)", flush=True)


def work_loop(room, adapter):
    """Runs queued jobs for this agent one at a time, next to the listener."""
    while True:
        time.sleep(3)
        try:
            names = sorted(n for n in os.listdir(WORK_DIR) if n.endswith(f"-{room.agent}.json"))
        except FileNotFoundError:
            continue
        for n in names:
            path = os.path.join(WORK_DIR, n)
            try:
                with open(path) as f:
                    job = json.load(f)
                os.remove(path)
            except (OSError, ValueError):
                continue
            key = (job["agent"], job["channel"])
            with _jobs_lock:
                _jobs["active"][key] = {"task": job["task"], "started": time.time()}
            try:
                run_job(room, adapter, job)
            finally:
                with _jobs_lock:
                    _jobs["active"].pop(key, None)


def take_work_line(room, turn, text):
    """Pull a WORK: line out of a reply and queue the job."""
    keep, tasks = [], []
    for line in text.splitlines():
        if line.strip().upper().startswith("WORK:"):
            tasks.append(line.split(":", 1)[1].strip())
        else:
            keep.append(line)
    text = "\n".join(keep).strip()
    if not tasks or not tasks[0]:
        return text
    ch = turn.get("channel", "general")
    with _jobs_lock:
        active = _jobs["active"].get((room.agent, ch))
    queued = []
    try:
        for n in os.listdir(WORK_DIR):
            if n.endswith(f"-{room.agent}.json"):
                with open(os.path.join(WORK_DIR, n)) as f:
                    j = json.load(f)
                if j["channel"] == ch:
                    queued.append(j["task"])
    except (OSError, ValueError):
        pass
    same = lambda a, b: a.lower()[:60] == b.lower()[:60]
    if (active and same(active["task"], tasks[0])) or any(same(q, tasks[0]) for q in queued):
        return text + "\n\n(Already on it. The job is running, and I'll post the result here.)"
    path, c = _work_count(room.agent)
    if c.get(room.agent, 0) >= WORK_CAP:
        return text + f"\n\n(Daily limit of {WORK_CAP} work jobs reached, so I can't start this one. The owner can start it in my session.)"
    c[room.agent] = c.get(room.agent, 0) + 1
    with open(path, "w") as f:
        json.dump(c, f)
    queue_work(room.agent, turn.get("channel", "general"), tasks[0])
    return text + f"\n\n▶ Started work: {tasks[0][:200]}\nI'll post the finished files here."


def report_session(room, channel, harness, sid, cwd=None):
    try:
        room.call("/api/sessions", {"channel": channel, "harness": harness, "session": sid,
                                    "host": socket.gethostname(), "open": open_cmd(harness, sid, cwd)})
    except (urllib.error.URLError, OSError):
        pass


def runner(room, args):
    adapter = pop_flag(args, "--adapter") or "claude"
    opts = {"cmd": pop_flag(args, "--cmd"), "model": pop_flag(args, "--model"), "base": pop_flag(args, "--base"),
            "adapter": adapter,
            "timeout": int(pop_flag(args, "--timeout") or 280)}
    standby = pop_flag(args, "--standby", has_value=False, default=False)
    rid = f"{socket.gethostname()}:{os.getpid()}"
    if adapter not in ADAPTERS:
        sys.exit(f"unknown adapter {adapter}. Pick one of: {', '.join(ADAPTERS)}")
    fn = ADAPTERS[adapter]
    if adapter in ("claude", "codex"):
        threading.Thread(target=work_loop, args=(room, adapter), daemon=True).start()
    print(f"runner {room.agent} via {adapter} on {rid}{' (standby)' if standby else ''}; waiting costs no tokens", flush=True)
    backoff = 2
    while True:
        try:
            r = room.call(f"/api/listen?wait=50&runner={rid}&host={socket.gethostname()}" + ("&standby=1" if standby else ""), timeout=70)
            backoff = 2
        except (urllib.error.URLError, OSError, ValueError) as e:
            print(f"listen failed: {e}; retry in {backoff}s", flush=True)
            time.sleep(backoff)
            backoff = min(backoff * 2, 60)
            continue
        turn = r.get("turn")
        if not turn:
            continue
        try:
            room.call("/api/ack", {"turn_id": turn["turn_id"], "runner": rid})
        except urllib.error.HTTPError:
            continue  # another runner has it
        except (urllib.error.URLError, OSError):
            continue
        print(f"turn {turn['turn_id']} ({turn['kind']}{', safe mode' if turn.get('safe') else ''}) -> waking {room.agent}", flush=True)
        t0 = time.time()
        ch = turn.get("channel", "general")
        with _jobs_lock:
            busy = _jobs["active"].get((room.agent, ch))
        # work jobs: only for your own threads, never in safe mode (a guest can't start a job with full tools)
        can_work = adapter in ("claude", "codex") and turn["kind"] != "actions" and not turn.get("safe")
        if busy and turn["kind"] != "actions":
            # the job is using this project's session; answer with status instead of disturbing it
            mins = int(time.time() - busy["started"]) // 60
            text, kind = f"Working on: {busy['task'][:200]} (started {mins} min ago). I'll post the result here when it's done.", "say"
        else:
            if can_work:
                turn = dict(turn, prompt=turn["prompt"] + WORK_NOTE)
            try:
                text, kind = fn(turn, opts) or "PASS", "say"
                if can_work:
                    text = take_work_line(room, turn, text) or "PASS"
                else:  # no jobs from safe-mode or adjourn turns; drop any stray WORK: line
                    text = "\n".join(l for l in text.splitlines() if not l.strip().upper().startswith("WORK:")).strip() or "PASS"
            except Exception as e:  # report and move on; never stall the room
                text, kind = f"(couldn't answer: {str(e)[:300]})", "error"
        bound = opts.pop("bound", None)
        if bound and bound[1]:
            report_session(room, turn.get("channel", "general"), *bound)
        for attempt in range(3):
            try:
                room.call("/api/say", {"text": text, "turn_id": turn["turn_id"], "kind": kind})
                break
            except (urllib.error.URLError, OSError) as e:
                print(f"post failed: {e}", flush=True)
                time.sleep(3)
        print(f"turn {turn['turn_id']} answered in {time.time() - t0:.0f}s", flush=True)


def setup(args):
    if len(args) < 3:
        sys.exit("usage: boardroom setup URL NAME KEY")
    url, name, key = args[0].rstrip("/"), args[1].upper(), args[2]
    try:
        conf = load_conf()
    except SystemExit:
        conf = {"keys": {}}
    conf["url"], conf.setdefault("keys", {})[name] = url, key
    conf.setdefault("default", name)
    os.makedirs(CONF_DIR, exist_ok=True)
    os.chmod(CONF_DIR, 0o700)
    with open(CONF, "w") as f:
        json.dump(conf, f, indent=1)
    os.chmod(CONF, 0o600)
    room = Room(conf, name)
    try:
        r = room.call("/api/state?since=999999999")
        print(f"Connected to {r['room']} as {r['me']}. Saved to {CONF}.")
    except urllib.error.HTTPError as e:
        sys.exit(f"Saved, but the room said HTTP {e.code}. Check the key." if e.code == 401 else f"Saved, but got HTTP {e.code}.")
    except (urllib.error.URLError, OSError) as e:
        print(f"Saved to {CONF}, but couldn't reach {url} yet ({e}). Is the server running?")


def install_runner(room, args):
    """Keep `boardroom runner` alive in the background and restart it after reboots."""
    me = os.path.abspath(sys.argv[0])
    extra = list(args)
    if "--adapter" not in extra:
        extra = ["--adapter", "claude" if "CLAUDE" in room.agent else "codex"] + extra
    argv = [sys.executable, me, "--as", room.agent, "runner"] + extra
    logs = os.path.join(CONF_DIR, "logs")
    os.makedirs(logs, exist_ok=True)
    log = os.path.join(logs, f"{room.agent}.log")
    path_env = os.pathsep.join([os.path.expanduser("~/.local/bin"), "/opt/homebrew/bin", "/usr/local/bin",
                                "/usr/bin", "/bin", os.environ.get("PATH", "")])
    label = f"io.boardroom.{room.agent.lower()}"
    if sys.platform == "darwin":
        from xml.sax.saxutils import escape
        plist = os.path.expanduser(f"~/Library/LaunchAgents/{label}.plist")
        os.makedirs(os.path.dirname(plist), exist_ok=True)
        args_xml = "".join(f"<string>{escape(a)}</string>" for a in argv)
        with open(plist, "w") as f:
            f.write(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>{label}</string>
<key>ProgramArguments</key><array>{args_xml}</array>
<key>EnvironmentVariables</key><dict><key>PATH</key><string>{escape(path_env)}</string><key>HOME</key><string>{escape(os.path.expanduser("~"))}</string></dict>
<key>WorkingDirectory</key><string>{escape(os.path.expanduser("~"))}</string>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
<key>StandardOutPath</key><string>{escape(log)}</string><key>StandardErrorPath</key><string>{escape(log)}</string>
</dict></plist>
""")
        subprocess.run(["launchctl", "unload", plist], capture_output=True)
        subprocess.run(["launchctl", "load", "-w", plist], check=True)
        print(f"Runner for {room.agent} is running ({plist}). Log: {log}")
        print(f"Stop it with: launchctl unload {plist}")
    elif sys.platform.startswith("linux"):
        import shlex
        unit_dir = os.path.expanduser("~/.config/systemd/user")
        os.makedirs(unit_dir, exist_ok=True)
        unit = os.path.join(unit_dir, f"{label}.service")
        with open(unit, "w") as f:
            f.write(f"""[Unit]
Description=Board Room runner for {room.agent}

[Service]
ExecStart={" ".join(shlex.quote(a) for a in argv)}
Environment=PATH={path_env}
Restart=always
RestartSec=5
StandardOutput=append:{log}
StandardError=append:{log}

[Install]
WantedBy=default.target
""")
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
        subprocess.run(["systemctl", "--user", "enable", "--now", f"{label}.service"], check=True)
        print(f"Runner for {room.agent} is running ({unit}). Log: {log}")
        print(f"Stop it with: systemctl --user disable --now {label}.service")
    else:
        print("No service manager support here. Keep this running instead:\n  " + " ".join(argv))


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    if args[0] == "setup":
        return setup(args[1:])
    if args[0] == "apikey":
        # boardroom apikey kimi   (asks for the key; stored in ~/.boardroom/config.json, mode 600)
        import getpass
        if len(args) < 2 or args[1] not in API_PRESETS:
            sys.exit(f"usage: boardroom apikey PROVIDER  ({', '.join(API_PRESETS)})")
        conf = load_conf()
        conf.setdefault("api_keys", {})[args[1]] = getpass.getpass(f"{args[1]} API key (input hidden): ").strip()
        with open(CONF, "w") as f:
            json.dump(conf, f, indent=1)
        os.chmod(CONF, 0o600)
        return print(f"Saved. Run a model runner with: boardroom --as NAME install-runner --adapter {args[1]}")
    conf = load_conf()
    room = Room(conf, pop_flag(args, "--as") or conf.get("default", ""))
    channel = pop_flag(args, "--channel") or "general"
    files = []
    while "--file" in args:
        files.append(upload(room, pop_flag(args, "--file")))
    cmd, rest = args[0], args[1:]
    if cmd == "say":
        r = room.call("/api/say", {"text": " ".join(rest), "channel": channel, "files": files})
        print(f"posted #{r['message']['id']}" + (f", woke {len(r['turns'])}" if r["turns"] else ""))
    elif cmd == "present":
        r = room.call("/api/say", {"text": " ".join(rest), "kind": "present", "channel": channel, "files": files})
        print(f"presented #{r['message']['id']}")
    elif cmd == "ask":
        wait = pop_flag(rest, "--wait", has_value=False, default=False)
        target, text = rest[0].upper().lstrip("@"), " ".join(rest[1:])
        r = room.call("/api/say", {"text": f"@{target} {text}", "channel": channel, "files": files})
        if not wait:
            print(f"asked {target} (#{r['message']['id']})")
            return
        for t in wait_turns(room, r["turns"]):
            print(f"{t.get('agent')}: {t.get('reply') or '(' + t['status'] + ')'}")
    elif cmd == "read":
        n = int(pop_flag(rest, "-n") or 30)
        r = room.call(f"/api/state?since=0&channel={channel}")
        for m in r["messages"][-n:]:
            print(fmt(m))
    elif cmd == "actions":
        status = "all" if "--all" in rest else "open"
        r = room.call(f"/api/actions?agent={room.agent}&status={status}")
        for a in r["actions"]:
            print(f"#{a['id']} [{a['status']}] {a['text']}  ({a['meeting']})")
        if not r["actions"]:
            print("no open action items")
    elif cmd == "done":
        room.call("/api/actions/done", {"id": int(rest[0]), "note": " ".join(rest[1:])})
        print(f"closed #{rest[0]}")
    elif cmd == "listen":
        while True:
            rid = "cli-" + socket.gethostname()
            r = room.call(f"/api/listen?wait=50&runner={rid}", timeout=70)
            if r.get("turn"):
                t = r["turn"]
                room.call("/api/ack", {"turn_id": t["turn_id"], "runner": rid})
                print(f"TURN {t['turn_id']}\n\n{t['prompt']}\n\n(answer with: boardroom reply {t['turn_id']} \"...\")")
                return
    elif cmd == "reply":
        room.call("/api/say", {"text": " ".join(rest[1:]), "turn_id": int(rest[0])})
        print("replied")
    elif cmd == "runner":
        runner(room, rest)
    elif cmd == "work":
        # boardroom --as CODEX work general "Build the launch checklist PDF from ..."
        ch, task = rest[0], " ".join(rest[1:])
        queue_work(room.agent, ch, task)
        room.call("/api/say", {"text": f"▶ Started work: {task[:300]}\nI'll post the finished files here.", "channel": ch})
        print(f"queued for {room.agent}'s runner in #{ch}")
    elif cmd == "install-runner":
        install_runner(room, rest)
    elif cmd == "bind":
        # boardroom --as CODEX bind my-project <session-id> [codex|claude]
        ch, sid = rest[0], rest[1]
        harness = rest[2] if len(rest) > 2 else ("claude" if "CLAUDE" in room.agent else "codex")
        session_set(room.agent, ch, sid)
        cwd = claude_session_cwd(sid) if harness == "claude" else codex_session_cwd(sid)
        report_session(room, ch, harness, sid, cwd)
        print(f"{room.agent} in #{ch} is now session {sid}. Open it with: {open_cmd(harness, sid, cwd)}")
    elif cmd == "channels":
        for c in room.call("/api/channels")["channels"]:
            print(f"{c['id']:16} {c['name']}")
    elif cmd == "whoami":
        print(room.agent, room.url)
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
