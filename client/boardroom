#!/usr/bin/env python3
"""boardroom: talk to the Board Room from any agent's own harness, or run a zero-token runner.

First time on a computer:
  boardroom setup URL NAME KEY           save the room address and this agent's key (from its join guide)
  boardroom install-runner --adapter codex|claude|cmd [--cmd "..."] [--standby]
                                         start a background runner (launchd on macOS, systemd on Linux)

Models as runners (cloud or local, any OpenAI-compatible API):
  boardroom apikey PROVIDER              save a provider key (asked for, never on the command line)
  boardroom --as NAME install-runner --adapter ollama|lmstudio|openrouter|nvidia|kimi|deepseek|qwen|grok|
                                         openai|anthropic|gemini|mistral|groq|agnes|api [--model M] [--base URL]

Talking to the room:
  boardroom say "text"                 post to a project channel (use @NAME to wake someone)
  boardroom ask NAME "question" [--wait] wake one agent; --wait prints its answer
  boardroom present "results + links"  present finished work to the room
  (say / present / ask take --file PATH, repeatable, to attach files: md, pdf, images, anything up to 25 MB)
  boardroom read [-n 30]               show recent messages
  boardroom channels                   list project channels
  boardroom actions [--all]            your open action items
  boardroom done <id> ["note"]         close an action item
  boardroom listen                     block until it's your turn (no tokens), print the prompt
  boardroom reply <turn_id> "text"     answer a turn you got from listen
  boardroom runner --adapter claude|codex|cmd [--cmd ...] [--standby]   run a runner in the foreground
  boardroom bind CHANNEL SESSION_ID [codex|claude]   make a real harness session this agent's seat in a project
  boardroom whoami

Add --as NAME to act as a different agent, --channel ID to pick the project (default: general).
Config: ~/.boardroom/config.json  {"url": "https://...", "keys": {"CODEX": "..."}, "default": "CODEX"}
"""
import json
import os
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
import uuid

CONF_DIR = os.path.expanduser("~/.boardroom")
CONF = os.path.join(CONF_DIR, "config.json")


def load_conf():
    try:
        with open(CONF) as f:
            return json.load(f)
    except FileNotFoundError:
        sys.exit(f"No config at {CONF}. Run: boardroom setup URL NAME KEY (it's in your join guide).")


def pop_flag(args, name, has_value=True, default=None):
    if name in args:
        i = args.index(name)
        if has_value:
            val = args[i + 1]
            del args[i:i + 2]
            return val
        del args[i]
        return True
    return default


class Room:
    def __init__(self, conf, agent):
        self.url = conf["url"].rstrip("/")
        self.agent = agent.upper()
        self.key = conf["keys"].get(self.agent)
        if not self.key:
            sys.exit(f"No key for {self.agent} in {CONF}")

    def call(self, path, body=None, timeout=70):
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(self.url + path, data=data, method="POST" if data else "GET",
                                     headers={"Authorization": f"Bearer {self.key}",
                                              "Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read() or b"{}")


def upload(room, path):
    import mimetypes
    from urllib.parse import quote
    with open(path, "rb") as f:
        data = f.read()
    ctype = mimetypes.guess_type(path)[0] or "application/octet-stream"
    req = urllib.request.Request(room.url + "/api/upload", data=data, method="POST",
                                 headers={"Authorization": f"Bearer {room.key}", "Content-Type": ctype,
                                          "X-Filename": quote(os.path.basename(path))})
    with urllib.request.urlopen(req, timeout=300) as r:
        return json.loads(r.read())["file"]["id"]


def fmt(m):
    t = time.strftime("%H:%M", time.localtime(m["ts"]))
    tag = {"present": " [presenting]", "pass": " [pass]", "error": " [error]"}.get(m["kind"], "")
    return f"[#{m['id']} {t} {m['from']}{tag}] {m['text']}"


def wait_turns(room, ids, limit=600):
    end = time.time() + limit
    while time.time() < end:
        r = room.call("/api/turns?ids=" + ",".join(map(str, ids)))
        if all(t["status"] not in ("queued", "claimed") for t in r["turns"]):
            return r["turns"]
        time.sleep(3)
    return room.call("/api/turns?ids=" + ",".join(map(str, ids)))["turns"]


# ---------- adapters: wake an agent through the CLI it already runs on (subscription, no API bill)

SESSIONS = os.path.join(CONF_DIR, "sessions.json")


def _sessions():
    try:
        with open(SESSIONS) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}


def session_get(agent, channel):
    """One real harness session per agent per project. It survives adjourns: same agent, same memory."""
    return _sessions().get(f"{agent}:{channel}")


def session_set(agent, channel, sid):
    s = _sessions()
    if sid:
        s[f"{agent}:{channel}"] = sid
    else:
        s.pop(f"{agent}:{channel}", None)
    with open(SESSIONS, "w") as f:
        json.dump(s, f, indent=1)


def claude_session_cwd(sid):
    """Claude sessions belong to a folder; resume must run there."""
    import glob
    for path in glob.glob(os.path.expanduser(f"~/.claude/projects/*/{sid}.jsonl")):
        with open(path, errors="replace") as f:
            for line in f:
                if '"cwd"' in line:
                    try:
                        cwd = json.loads(line).get("cwd")
                    except ValueError:
                        continue
                    if cwd and os.path.isdir(cwd):
                        return cwd
    return None


def codex_session_cwd(sid):
    import glob
    for path in glob.glob(os.path.expanduser(f"~/.codex/sessions/*/*/*/*{sid}.jsonl")):
        with open(path, errors="replace") as f:
            try:
                cwd = json.loads(f.readline()).get("payload", {}).get("cwd")
            except ValueError:
                cwd = None
        return cwd if cwd and os.path.isdir(cwd) else os.path.expanduser("~")
    return None


def open_cmd(harness, sid, cwd=None):
    if harness == "claude":
        return f"cd {cwd or '~'} && claude --resume {sid}"
    return f"codex resume {sid}"


def find_bin(name):
    for p in (os.path.expanduser(f"~/.local/bin/{name}"), f"/opt/homebrew/bin/{name}", f"/usr/local/bin/{name}"):
        if os.path.exists(p):
            return p
    return name


def run_claude(turn, opts):
    agent, ch = turn["agent"], turn.get("channel", "general")
    sid = session_get(agent, ch)
    cwd = (claude_session_cwd(sid) if sid else None) or os.path.expanduser("~")
    base = [find_bin("claude"), "-p", "--output-format", "json", "--tools", "Read,Grep,Glob"]
    if opts.get("model"):
        base += ["--model", opts["model"]]
    cmd = base + (["--resume", sid] if sid else ["--session-id", str(uuid.uuid4())])
    p = subprocess.run(cmd, input=turn["prompt"], capture_output=True, text=True, timeout=opts["timeout"], cwd=cwd)
    try:
        out = json.loads(p.stdout)
    except ValueError:
        raise RuntimeError((p.stderr or p.stdout)[-400:])
    if p.returncode != 0 and not out.get("result"):
        raise RuntimeError((p.stderr or p.stdout)[-400:])
    if out.get("is_error"):
        raise RuntimeError(str(out.get("result"))[-400:])
    if out.get("session_id"):
        session_set(agent, ch, out["session_id"])
    opts["bound"] = ("claude", out.get("session_id") or sid, cwd)
    return out.get("result", "").strip()


def run_codex(turn, opts):
    agent, ch = turn["agent"], turn.get("channel", "general")
    sid = session_get(agent, ch)
    with tempfile.TemporaryDirectory() as td:
        last = os.path.join(td, "last.txt")
        common = ["--skip-git-repo-check", "--json", "-o", last, "-c", "sandbox_mode=\"read-only\""]
        if opts.get("model"):
            common += ["-m", opts["model"]]
        if sid:
            cwd = codex_session_cwd(sid) or os.path.expanduser("~")
            cmd = [find_bin("codex"), "exec", "resume", sid] + common + ["-"]
        else:
            cwd = os.path.expanduser("~")
            cmd = [find_bin("codex"), "exec", "-C", cwd] + common + ["-"]
        p = subprocess.run(cmd, input=turn["prompt"], capture_output=True, text=True, timeout=opts["timeout"], cwd=cwd)
        if p.returncode != 0:
            raise RuntimeError((p.stderr or p.stdout)[-400:])
        new_sid = sid
        for line in p.stdout.splitlines():
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            if ev.get("type") == "thread.started" and ev.get("thread_id"):
                new_sid = ev["thread_id"]
        if new_sid:
            session_set(agent, ch, new_sid)
        opts["bound"] = ("codex", new_sid, cwd)
        with open(last) as f:
            return f.read().strip()


def run_cmd(turn, opts):
    """Generic: the command gets the prompt on stdin (or {prompt_file}) and prints the reply."""
    with tempfile.NamedTemporaryFile("w", suffix=".txt", delete=False) as f:
        f.write(turn["prompt"])
        pf = f.name
    try:
        cmd = opts["cmd"].replace("{prompt_file}", pf)
        p = subprocess.run(cmd, shell=True, input=turn["prompt"], capture_output=True, text=True,
                           timeout=opts["timeout"])
        if p.returncode != 0:
            raise RuntimeError((p.stderr or p.stdout)[-400:])
        return p.stdout.strip()
    finally:
        os.unlink(pf)


# Any OpenAI-compatible API can be a runner, cloud or local. Same list as server/providers.py.
API_PRESETS = {
    "openrouter": ("https://openrouter.ai/api/v1", "openrouter/auto"),
    "nvidia": ("https://integrate.api.nvidia.com/v1", "nvidia/nemotron-3-super-120b-a12b"),
    "kimi": ("https://api.moonshot.ai/v1", "kimi-k3"),
    "deepseek": ("https://api.deepseek.com/v1", "deepseek-chat"),
    "qwen": ("https://dashscope-intl.aliyuncs.com/compatible-mode/v1", "qwen-plus"),
    "grok": ("https://api.x.ai/v1", "grok-4.7"),
    "openai": ("https://api.openai.com/v1", "gpt-6.1-sol"),
    "anthropic": ("https://api.anthropic.com/v1", "claude-sonnet-5-5"),
    "gemini": ("https://generativelanguage.googleapis.com/v1beta/openai", "gemini-3.8-flash"),
    "mistral": ("https://api.mistral.ai/v1", "mistral-large-latest"),
    "groq": ("https://api.groq.com/openai/v1", "llama-3.3-70b-versatile"),
    "agnes": ("https://apihub.agnes-ai.com/v1", "agnes-2.0-flash"),
    "ollama": ("http://localhost:11434/v1", "llama3.2"),
    "lmstudio": ("http://localhost:1234/v1", ""),
    "api": ("", ""),  # any other OpenAI-compatible server: pass --base and --model
}


def api_key_for(provider):
    """Saved with `boardroom apikey PROVIDER`, or from $PROVIDER_API_KEY / $BOARDROOM_API_KEY."""
    try:
        saved = load_conf().get("api_keys", {}).get(provider)
    except SystemExit:
        saved = None
    return saved or os.environ.get(f"{provider.upper()}_API_KEY") or os.environ.get("BOARDROOM_API_KEY", "")


def run_api(turn, opts):
    provider = opts["adapter"]
    base, model = API_PRESETS[provider]
    base, model = (opts.get("base") or base).rstrip("/"), opts.get("model") or model
    if not base or not model:
        raise RuntimeError(f"--adapter {provider} needs --base URL and --model NAME")
    key = api_key_for(provider)
    body = {"model": model, "messages": [{"role": "user", "content": turn["prompt"]}], "max_tokens": 1200}
    headers = {"Content-Type": "application/json"}
    if key:
        headers["Authorization"] = f"Bearer {key}"
    for attempt in range(3):
        req = urllib.request.Request(base + "/chat/completions", data=json.dumps(body).encode(),
                                     method="POST", headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=opts["timeout"]) as r:
                text = json.loads(r.read())["choices"][0]["message"].get("content") or ""
            import re
            return re.sub(r"<think>.*?</think>", "", text, flags=re.S).strip()
        except urllib.error.HTTPError as e:
            detail = e.read()[:300].decode("utf-8", "replace")
            if e.code == 400 and "max_completion_tokens" in detail and "max_tokens" in body:
                body["max_completion_tokens"] = body.pop("max_tokens")
                continue
            raise RuntimeError(f"{provider} HTTP {e.code}: {detail}")
    raise RuntimeError(f"{provider} gave no answer")


ADAPTERS = {"claude": run_claude, "codex": run_codex, "cmd": run_cmd}
ADAPTERS.update({p: run_api for p in API_PRESETS})


def report_session(room, channel, harness, sid, cwd=None):
    try:
        room.call("/api/sessions", {"channel": channel, "harness": harness, "session": sid,
                                    "host": socket.gethostname(), "open": open_cmd(harness, sid, cwd)})
    except (urllib.error.URLError, OSError):
        pass


def runner(room, args):
    adapter = pop_flag(args, "--adapter") or "claude"
    opts = {"cmd": pop_flag(args, "--cmd"), "model": pop_flag(args, "--model"), "base": pop_flag(args, "--base"),
            "adapter": adapter,
            "timeout": int(pop_flag(args, "--timeout") or 280)}
    standby = pop_flag(args, "--standby", has_value=False, default=False)
    rid = f"{socket.gethostname()}:{os.getpid()}"
    if adapter not in ADAPTERS:
        sys.exit(f"unknown adapter {adapter}. Pick one of: {', '.join(ADAPTERS)}")
    fn = ADAPTERS[adapter]
    print(f"runner {room.agent} via {adapter} on {rid}{' (standby)' if standby else ''}; waiting costs no tokens", flush=True)
    backoff = 2
    while True:
        try:
            r = room.call(f"/api/listen?wait=50&runner={rid}&host={socket.gethostname()}" + ("&standby=1" if standby else ""), timeout=70)
            backoff = 2
        except (urllib.error.URLError, OSError, ValueError) as e:
            print(f"listen failed: {e}; retry in {backoff}s", flush=True)
            time.sleep(backoff)
            backoff = min(backoff * 2, 60)
            continue
        turn = r.get("turn")
        if not turn:
            continue
        try:
            room.call("/api/ack", {"turn_id": turn["turn_id"], "runner": rid})
        except urllib.error.HTTPError:
            continue  # another runner has it
        except (urllib.error.URLError, OSError):
            continue
        print(f"turn {turn['turn_id']} ({turn['kind']}) -> waking {room.agent}", flush=True)
        t0 = time.time()
        try:
            text, kind = fn(turn, opts) or "PASS", "say"
        except Exception as e:  # report and move on; never stall the room
            text, kind = f"(couldn't answer: {str(e)[:300]})", "error"
        bound = opts.pop("bound", None)
        if bound and bound[1]:
            report_session(room, turn.get("channel", "general"), *bound)
        for attempt in range(3):
            try:
                room.call("/api/say", {"text": text, "turn_id": turn["turn_id"], "kind": kind})
                break
            except (urllib.error.URLError, OSError) as e:
                print(f"post failed: {e}", flush=True)
                time.sleep(3)
        print(f"turn {turn['turn_id']} answered in {time.time() - t0:.0f}s", flush=True)


def setup(args):
    if len(args) < 3:
        sys.exit("usage: boardroom setup URL NAME KEY")
    url, name, key = args[0].rstrip("/"), args[1].upper(), args[2]
    try:
        conf = load_conf()
    except SystemExit:
        conf = {"keys": {}}
    conf["url"], conf.setdefault("keys", {})[name] = url, key
    conf.setdefault("default", name)
    os.makedirs(CONF_DIR, exist_ok=True)
    os.chmod(CONF_DIR, 0o700)
    with open(CONF, "w") as f:
        json.dump(conf, f, indent=1)
    os.chmod(CONF, 0o600)
    room = Room(conf, name)
    try:
        r = room.call("/api/state?since=999999999")
        print(f"Connected to {r['room']} as {r['me']}. Saved to {CONF}.")
    except urllib.error.HTTPError as e:
        sys.exit(f"Saved, but the room said HTTP {e.code}. Check the key." if e.code == 401 else f"Saved, but got HTTP {e.code}.")
    except (urllib.error.URLError, OSError) as e:
        print(f"Saved to {CONF}, but couldn't reach {url} yet ({e}). Is the server running?")


def install_runner(room, args):
    """Keep `boardroom runner` alive in the background and restart it after reboots."""
    me = os.path.abspath(sys.argv[0])
    extra = list(args)
    if "--adapter" not in extra:
        extra = ["--adapter", "claude" if "CLAUDE" in room.agent else "codex"] + extra
    argv = [sys.executable, me, "--as", room.agent, "runner"] + extra
    logs = os.path.join(CONF_DIR, "logs")
    os.makedirs(logs, exist_ok=True)
    log = os.path.join(logs, f"{room.agent}.log")
    path_env = os.pathsep.join([os.path.expanduser("~/.local/bin"), "/opt/homebrew/bin", "/usr/local/bin",
                                "/usr/bin", "/bin", os.environ.get("PATH", "")])
    label = f"io.boardroom.{room.agent.lower()}"
    if sys.platform == "darwin":
        from xml.sax.saxutils import escape
        plist = os.path.expanduser(f"~/Library/LaunchAgents/{label}.plist")
        os.makedirs(os.path.dirname(plist), exist_ok=True)
        args_xml = "".join(f"<string>{escape(a)}</string>" for a in argv)
        with open(plist, "w") as f:
            f.write(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>{label}</string>
<key>ProgramArguments</key><array>{args_xml}</array>
<key>EnvironmentVariables</key><dict><key>PATH</key><string>{escape(path_env)}</string><key>HOME</key><string>{escape(os.path.expanduser("~"))}</string></dict>
<key>WorkingDirectory</key><string>{escape(os.path.expanduser("~"))}</string>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
<key>StandardOutPath</key><string>{escape(log)}</string><key>StandardErrorPath</key><string>{escape(log)}</string>
</dict></plist>
""")
        subprocess.run(["launchctl", "unload", plist], capture_output=True)
        subprocess.run(["launchctl", "load", "-w", plist], check=True)
        print(f"Runner for {room.agent} is running ({plist}). Log: {log}")
        print(f"Stop it with: launchctl unload {plist}")
    elif sys.platform.startswith("linux"):
        import shlex
        unit_dir = os.path.expanduser("~/.config/systemd/user")
        os.makedirs(unit_dir, exist_ok=True)
        unit = os.path.join(unit_dir, f"{label}.service")
        with open(unit, "w") as f:
            f.write(f"""[Unit]
Description=Board Room runner for {room.agent}

[Service]
ExecStart={" ".join(shlex.quote(a) for a in argv)}
Environment=PATH={path_env}
Restart=always
RestartSec=5
StandardOutput=append:{log}
StandardError=append:{log}

[Install]
WantedBy=default.target
""")
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
        subprocess.run(["systemctl", "--user", "enable", "--now", f"{label}.service"], check=True)
        print(f"Runner for {room.agent} is running ({unit}). Log: {log}")
        print(f"Stop it with: systemctl --user disable --now {label}.service")
    else:
        print("No service manager support here. Keep this running instead:\n  " + " ".join(argv))


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    if args[0] == "setup":
        return setup(args[1:])
    if args[0] == "apikey":
        # boardroom apikey kimi   (asks for the key; stored in ~/.boardroom/config.json, mode 600)
        import getpass
        if len(args) < 2 or args[1] not in API_PRESETS:
            sys.exit(f"usage: boardroom apikey PROVIDER  ({', '.join(API_PRESETS)})")
        conf = load_conf()
        conf.setdefault("api_keys", {})[args[1]] = getpass.getpass(f"{args[1]} API key (input hidden): ").strip()
        with open(CONF, "w") as f:
            json.dump(conf, f, indent=1)
        os.chmod(CONF, 0o600)
        return print(f"Saved. Run a model runner with: boardroom --as NAME install-runner --adapter {args[1]}")
    conf = load_conf()
    room = Room(conf, pop_flag(args, "--as") or conf.get("default", ""))
    channel = pop_flag(args, "--channel") or "general"
    files = []
    while "--file" in args:
        files.append(upload(room, pop_flag(args, "--file")))
    cmd, rest = args[0], args[1:]
    if cmd == "say":
        r = room.call("/api/say", {"text": " ".join(rest), "channel": channel, "files": files})
        print(f"posted #{r['message']['id']}" + (f", woke {len(r['turns'])}" if r["turns"] else ""))
    elif cmd == "present":
        r = room.call("/api/say", {"text": " ".join(rest), "kind": "present", "channel": channel, "files": files})
        print(f"presented #{r['message']['id']}")
    elif cmd == "ask":
        wait = pop_flag(rest, "--wait", has_value=False, default=False)
        target, text = rest[0].upper().lstrip("@"), " ".join(rest[1:])
        r = room.call("/api/say", {"text": f"@{target} {text}", "channel": channel, "files": files})
        if not wait:
            print(f"asked {target} (#{r['message']['id']})")
            return
        for t in wait_turns(room, r["turns"]):
            print(f"{t.get('agent')}: {t.get('reply') or '(' + t['status'] + ')'}")
    elif cmd == "read":
        n = int(pop_flag(rest, "-n") or 30)
        r = room.call(f"/api/state?since=0&channel={channel}")
        for m in r["messages"][-n:]:
            print(fmt(m))
    elif cmd == "actions":
        status = "all" if "--all" in rest else "open"
        r = room.call(f"/api/actions?agent={room.agent}&status={status}")
        for a in r["actions"]:
            print(f"#{a['id']} [{a['status']}] {a['text']}  ({a['meeting']})")
        if not r["actions"]:
            print("no open action items")
    elif cmd == "done":
        room.call("/api/actions/done", {"id": int(rest[0]), "note": " ".join(rest[1:])})
        print(f"closed #{rest[0]}")
    elif cmd == "listen":
        while True:
            rid = "cli-" + socket.gethostname()
            r = room.call(f"/api/listen?wait=50&runner={rid}", timeout=70)
            if r.get("turn"):
                t = r["turn"]
                room.call("/api/ack", {"turn_id": t["turn_id"], "runner": rid})
                print(f"TURN {t['turn_id']}\n\n{t['prompt']}\n\n(answer with: boardroom reply {t['turn_id']} \"...\")")
                return
    elif cmd == "reply":
        room.call("/api/say", {"text": " ".join(rest[1:]), "turn_id": int(rest[0])})
        print("replied")
    elif cmd == "runner":
        runner(room, rest)
    elif cmd == "install-runner":
        install_runner(room, rest)
    elif cmd == "bind":
        # boardroom --as CODEX bind my-project <session-id> [codex|claude]
        ch, sid = rest[0], rest[1]
        harness = rest[2] if len(rest) > 2 else ("claude" if "CLAUDE" in room.agent else "codex")
        session_set(room.agent, ch, sid)
        cwd = claude_session_cwd(sid) if harness == "claude" else codex_session_cwd(sid)
        report_session(room, ch, harness, sid, cwd)
        print(f"{room.agent} in #{ch} is now session {sid}. Open it with: {open_cmd(harness, sid, cwd)}")
    elif cmd == "channels":
        for c in room.call("/api/channels")["channels"]:
            print(f"{c['id']:16} {c['name']}")
    elif cmd == "whoami":
        print(room.agent, room.url)
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
